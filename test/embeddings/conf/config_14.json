{
	"filesroot":"$[workdir]$/files",
	"logger":{
		"name":"llmengine-embedding",
		"levelname":"info",
		"logfile":"$[workdir]$/logs/llmengine.log"
	},
	"website":{
		"paths":[
			["$[workdir]$/wwwroot",""]
		],
		"client_max_size":10000,
		"host":"0.0.0.0",
		"port":9995,
		"coding":"utf-8",
		"indexes":["index.html","index.ui"],
		"startswiths":[
			{"leading":"/idfile","registerfunction":"idfile"},
			{"leading":"/v1/embeddings","registerfunction":"embeddings"},
			{"leading":"/docs","registerfunction":"docs"}
		],
		"processors":[
			[".tmpl","tmpl"],[".app","app"],[".ui","bui"],[".dspy","dspy"],[".md","md"]
		],
		"session_max_time":3000,
		"session_issue_time":2500
	}
}